API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3001
POLL_INTERVAL_MS=30000
STALE_AFTER_MS=120000
# Untuk HTTP pada host LAN non-lokal di lingkungan dev saja; jangan dipakai production.
ALLOW_HTTP_SOURCE_DEV=false
DATABASE_URL=postgresql://monitoring_kadis_app:CHANGE_ME@127.0.0.1:5432/monitoring_kadis
PG_POOL_MAX=10
PG_SSL=false
# Required only by docker-compose.oracle-sim.yml; use the same password as DATABASE_URL locally.
PG_SIM_PASSWORD=CHANGE_ME
# Optional CA certificate path when PG_SSL=true and PostgreSQL uses a private CA.
PG_SSL_CA_PATH=

# HMAC webhook per source. Keep these secrets out of Git and use HTTPS.
WEBHOOK_KEY_ID_INVENTORY_ASET=
WEBHOOK_SECRET_INVENTORY_ASET=
WEBHOOK_KEY_ID_MITRA_PKS=
WEBHOOK_SECRET_MITRA_PKS=
WEBHOOK_KEY_ID_APP_MOBILE=
WEBHOOK_SECRET_APP_MOBILE=
WEBHOOK_KEY_ID_ANTRIAN_UMUM=
WEBHOOK_SECRET_ANTRIAN_UMUM=
WEBHOOK_KEY_ID_ANTRIAN_PTSP=
WEBHOOK_SECRET_ANTRIAN_PTSP=

# Session cookie settings. Enable Secure cookies behind HTTPS in staging/production.
COOKIE_SECURE=false

# Set only for one-time initial-admin bootstrap, then remove from the environment.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional read-only Oracle source for applications without an API. Use a DBA-approved aggregate view.
ORACLE_SOURCE_ENABLED=false
ORACLE_SOURCE_CONNECT_STRING=127.0.0.1:1521/FREEPDB1
# Local Oracle Free simulation only; not read by the runtime backend.
ORACLE_ADMIN_PASSWORD=
ORACLE_SOURCE_USER=KADIS_SOURCE_READER
ORACLE_SOURCE_PASSWORD=
ORACLE_SOURCE_VIEW=SYSTEM.MONITORING_SOURCE_SUMMARY_V
ORACLE_SOURCE_IDS=monitoring_blangko

# Isi URL lengkap dan token baca dari masing-masing aplikasi sumber.
# Bila kosong, layar menampilkan Belum terhubung tanpa angka.
INVENTORY_SUMMARY_URL=
INVENTORY_HEALTH_URL=
INVENTORY_READ_TOKEN=
QUEUE_UMUM_SUMMARY_URL=
QUEUE_UMUM_HEALTH_URL=
QUEUE_UMUM_READ_TOKEN=
QUEUE_PTSP_SUMMARY_URL=
QUEUE_PTSP_HEALTH_URL=
QUEUE_PTSP_READ_TOKEN=
SIPONCAN_MITRA_SUMMARY_URL=
SIPONCAN_MOBILE_SUMMARY_URL=
SIPONCAN_READ_TOKEN=
